<?xml version="1.0" encoding="utf-8"?>
<!-- Folds YamlDotNet into TheHammerOfOden.dll after each build; see the csproj. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="ILRepacker" AfterTargets="Build">
    <ItemGroup>
      <InputAssemblies Include="$(TargetPath)" />
      <InputAssemblies Include="$(OutputPath)YamlDotNet.dll" />
    </ItemGroup>
    <ILRepack Parallel="true" DebugInfo="false" Internalize="true" InputAssemblies="@(InputAssemblies)"
              OutputFile="$(TargetPath)" TargetKind="SameAsPrimaryAssembly" LibraryPath="$(OutputPath);$(ValheimManaged);$(BepInExCore)" />
  </Target>
</Project>
